<Application x:Class="EDHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundDark" Color="#0A0E14"/>
    <SolidColorBrush x:Key="BackgroundPanel" Color="#111820"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="#1A2332"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#FF6B2B"/>
    <SolidColorBrush x:Key="AccentGold" Color="#E8A628"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#3D9EE8"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8899AA"/>
    <SolidColorBrush x:Key="BorderColor" Color="#2A3F55"/>
  </Application.Resources>
</Application>
