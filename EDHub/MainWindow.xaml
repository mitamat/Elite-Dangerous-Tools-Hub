<Window x:Class="EDHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfwv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Elite Dangerous Tools Hub" Height="900" Width="1400"
        Background="{StaticResource BackgroundDark}"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style x:Key="NavSectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="16,10,16,2"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundCard}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BackgroundCard}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolbarButtonMuted" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource BackgroundPanel}"
            BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,18,16,14"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="◆" Foreground="{StaticResource AccentOrange}" FontSize="20" VerticalAlignment="Center"/>
            <TextBlock Text="ED Tools Hub" Foreground="{StaticResource AccentGold}" FontSize="15"
                       FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,8,0,8">
            <TextBlock Text="MARKET &amp; TRADE" Style="{StaticResource NavSectionLabel}"/>
            <Button Content="📡  EDMC" Tag="edmc" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🌐  Inara" Tag="inara" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🔧  ED Tools" Tag="edtools" Style="{StaticResource NavButton}" Click="NavItem_Click"/>

            <TextBlock Text="ROUTE &amp; EXPLORATION" Style="{StaticResource NavSectionLabel}"/>
            <Button Content="🗺️  Spansh" Tag="spansh" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🔭  ED Astro" Tag="edastro" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="📚  GEC" Tag="gec" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🚀  ED Discovery" Tag="eddiscovery" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🔬  ED Observatory" Tag="edobservatory" Style="{StaticResource NavButton}" Click="NavItem_Click"/>

            <TextBlock Text="SHIP BUILDING" Style="{StaticResource NavSectionLabel}"/>
            <Button Content="🛸  Coriolis" Tag="coriolis" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🤖  EDCoPilot" Tag="edcopilot" Style="{StaticResource NavButton}" Click="NavItem_Click"/>

            <TextBlock Text="ODYSSEY &amp; SURFACE" Style="{StaticResource NavSectionLabel}"/>
            <Button Content="🌍  SRV Survey" Tag="srvsurvey" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="⚗️  Material Helper" Tag="edmaterialhelper" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🗺️  Odyssey Map Guide" Tag="omg" Style="{StaticResource NavButton}" Click="NavItem_Click"/>

            <TextBlock Text="COLONISATION &amp; GUIDES" Style="{StaticResource NavSectionLabel}"/>
            <Button Content="🏗️  Raven Colonial" Tag="ravencolonial" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🇫🇷  Élite Dangereuse" Tag="elitedangereuse" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
            <Button Content="🌈  Spectral Analysis" Tag="spectral" Style="{StaticResource NavButton}" Click="NavItem_Click"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Column="1">

      <!-- Dashboard -->
      <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
          <TextBlock Text="Elite Dangerous Tools Hub" Foreground="{StaticResource AccentGold}"
                     FontSize="26" FontWeight="Light"/>
          <TextBlock Text="Elite Dangerous Tools Hub — All tools in one place"
                     Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,6,0,24"/>
          <WrapPanel x:Name="ToolCardPanel" ItemWidth="230" ItemHeight="156"/>
        </StackPanel>
      </ScrollViewer>

      <!-- WebView Panel -->
      <Grid x:Name="WebViewPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundPanel}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,0">
          <DockPanel>
            <Button Content="← Back" DockPanel.Dock="Left" Click="BackButton_Click"
                    Style="{StaticResource ToolbarButton}"/>
            <Button x:Name="OpenExternalBtn" Content="Open in Browser ↗" DockPanel.Dock="Right"
                    Style="{StaticResource ToolbarButtonMuted}" Click="OpenExternal_Click"/>
            <TextBlock x:Name="WebViewTitle" Foreground="{StaticResource AccentGold}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
          </DockPanel>
        </Border>
        <wpfwv2:WebView2 x:Name="MainWebView" Grid.Row="1"/>
      </Grid>

      <!-- Image Viewer Panel -->
      <Grid x:Name="ImageViewerPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundPanel}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,0">
          <DockPanel>
            <Button Content="← Back" DockPanel.Dock="Left" Click="BackButton_Click"
                    Style="{StaticResource ToolbarButton}"/>
            <Button Content="Fit to Window" DockPanel.Dock="Right" Click="ImageFit_Click"
                    Style="{StaticResource ToolbarButtonMuted}"/>
            <TextBlock x:Name="ImageZoomLabel" DockPanel.Dock="Right"
                       Foreground="{StaticResource TextMuted}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock x:Name="ImageViewerTitle" Foreground="{StaticResource AccentGold}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#050810" ClipToBounds="True" x:Name="ImageViewerBorder"
                MouseWheel="ImageViewer_MouseWheel">
          <Canvas x:Name="ImageCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Image x:Name="DiagramImage" RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="Image_MouseDown"
                   MouseLeftButtonUp="Image_MouseUp"
                   MouseMove="Image_MouseMove">
              <Image.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="ImageScale"/>
                  <TranslateTransform x:Name="ImageTranslate"/>
                </TransformGroup>
              </Image.RenderTransform>
            </Image>
          </Canvas>
        </Border>
      </Grid>

      <!-- Desktop App Launch Panel -->
      <Grid x:Name="DesktopAppPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundPanel}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,0">
          <DockPanel>
            <Button Content="← Back" DockPanel.Dock="Left" Click="BackButton_Click"
                    Style="{StaticResource ToolbarButton}"/>
            <TextBlock x:Name="DesktopAppTitle" Foreground="{StaticResource AccentGold}"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
          <TextBlock x:Name="DesktopAppIcon" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <TextBlock x:Name="DesktopAppName" Foreground="{StaticResource AccentGold}"
                     FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <TextBlock x:Name="DesktopAppDesc" Foreground="{StaticResource TextMuted}"
                     FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                     LineHeight="22" Margin="0,0,0,16"/>

          <!-- Install status badge -->
          <TextBlock x:Name="InstallStatusText" FontSize="12" HorizontalAlignment="Center"
                     Margin="0,0,0,16" Foreground="{StaticResource TextMuted}"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button x:Name="LaunchBtn" Content="Launch Application" Click="LaunchApp_Click"
                    Background="{StaticResource AccentOrange}" Foreground="White"
                    Padding="20,10" FontSize="14" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
            <Button x:Name="InstallBtn" Content="Install" Click="InstallBtn_Click"
                    Background="{StaticResource AccentBlue}" Foreground="White"
                    Padding="20,10" FontSize="14" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"
                    Visibility="Collapsed"/>
            <Button x:Name="UpdateBtn" Content="Update Available ↑" Click="InstallBtn_Click"
                    Background="#2A6F2A" Foreground="White"
                    Padding="20,10" FontSize="14" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"
                    Visibility="Collapsed"/>
            <Button x:Name="GitHubBtn" Content="View on GitHub ↗" Click="GitHub_Click"
                    Style="{StaticResource ToolbarButton}" Padding="16,10" FontSize="13"/>
          </StackPanel>

          <!-- Download progress -->
          <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"
                       Foreground="{StaticResource AccentBlue}"
                       Background="{StaticResource BackgroundCard}"
                       BorderThickness="0" Margin="0,0,0,8"
                       Visibility="Collapsed"/>
          <TextBlock x:Name="DownloadStatusText" FontSize="11" HorizontalAlignment="Center"
                     Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"
                     Visibility="Collapsed"/>

          <TextBlock x:Name="InstallNote" Foreground="{StaticResource TextMuted}"
                     FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
        </StackPanel>
      </Grid>

    </Grid>
  </Grid>
</Window>
